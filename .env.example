NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://root:password@localhost:3306/finance_ts"
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
JWT_SECRET=replace_with_a_long_secret_here

RECOMMENDATION_SAVINGS_TARGET_PERCENT=20
RECOMMENDATION_DAILY_SAFETY_BUFFER_PERCENT=15
RECOMMENDATION_WEEKEND_MULTIPLIER=1.1
RECOMMENDATION_HOLIDAY_MULTIPLIER=1.25
RECOMMENDATION_OVESPEND_WARNING_PERCENT=10
RECOMMENDATION_BEHAVIOR_WINDOW_DAYS=30
RECOMMENDATION_HISTORY_LIMIT=30

FORECAST_DEFAULT_HORIZON_DAYS=30
FORECAST_MAX_HORIZON_DAYS=90
FORECAST_SPENDING_TREND_WINDOW_DAYS=14
FORECAST_CONSERVATIVE_MULTIPLIER=0.9
FORECAST_BALANCED_MULTIPLIER=1
FORECAST_STRETCH_MULTIPLIER=1.15
FORECAST_SAVINGS_PROJECTION_PERCENT=20
FORECAST_ML_SIGNAL_THRESHOLD=0.65
